# Local secrets for `supabase functions serve --env-file supabase/functions/.env`.
# Copy this file to supabase/functions/.env for local dev, and set the same
# values in production with:
#   supabase secrets set --env-file supabase/functions/.env
# Never commit supabase/functions/.env itself (it's gitignored).

# --- google-merchant-sync ---------------------------------------------------

# Base64-encode the ENTIRE service account JSON key file you download from
# Google Cloud Console and paste the result here. Generate this yourself —
# see the manual setup steps in the PR/commit description.
#
# Not raw JSON: `supabase secrets set --env-file` mangles a raw JSON value
# down to a single `{` character, because its dotenv-style parser can't
# handle a value packed with unescaped double quotes. Base64 has no quotes
# or newlines for it to trip on.
#
#   macOS:  base64 -i service-account.json | tr -d '\n'
#   Linux:  base64 -w0 service-account.json
#
GOOGLE_MERCHANT_SERVICE_ACCOUNT_KEY_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwuLi59

# Your numeric Merchant Center account ID (Merchant Center > Settings > Account information).
GOOGLE_MERCHANT_ACCOUNT_ID=1234567890

# The id of a primary data source of type "API" in Merchant Center that this
# integration writes through (Merchant Center > Data sources > Add data
# source > "Product data API"). Not the same as the account id.
GOOGLE_MERCHANT_DATA_SOURCE_ID=1234567890

# Optional — defaults shown.
GOOGLE_MERCHANT_API_VERSION=v1
GOOGLE_MERCHANT_FEED_LABEL=ZA
GOOGLE_MERCHANT_CONTENT_LANGUAGE=en
GOOGLE_MERCHANT_SITE_URL=https://vrilcouture.com
GOOGLE_MERCHANT_DEFAULT_BRAND=Vril Couture
