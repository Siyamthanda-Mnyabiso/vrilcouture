# Copy this file to .env and fill in real values. Never commit .env itself.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Merchant Center sync (Google Cloud service account, Merchant API
# "products" sub-API) does NOT belong here. It runs server-side only, inside
# the google-merchant-sync Supabase Edge Function — see
# supabase/functions/.env.example for those variables. A service-account
# private key must never be prefixed VITE_ or referenced from src/, or it
# ships to every browser.
